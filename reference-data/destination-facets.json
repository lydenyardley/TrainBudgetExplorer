      "coverage": "United Kingdom, as covered by the DTD feed"
    },
    "rspb": {
      "name": "reviewed list of stations reaching RSPB reserves, linked by the hybrid closest-station prune",
      "url": "https://www.rspb.org.uk/nature-reserves/",
      "coverage": "United Kingdom, as covered by the DTD feed"
    },
    "national_trust": {
      "name": "reviewed list of stations reaching National Trust visitor properties, linked by the hybrid closest-station prune",
      "url": "https://www.nationaltrust.org.uk/visit",
      "coverage": "England, Wales and Northern Ireland, as covered by the DTD feed"
    },
    "national_park": {
