#!/bin/sh
# Check the messages of the commits a push adds, before they leave the machine.
# The deploy workflow runs the same checker as the backstop, but a rejection
# there has already landed the commits, so fixing one costs a second push.
# The checker also resolves the base a ref the remote has never seen is measured
# against, so the hook does not work one out for itself.
# Enable once per clone with
#   git config core.hooksPath .githooks
ROOT=$(cd "$(dirname "$0")/.." && pwd)
PY=$(command -v python || command -v python3)
ZERO=0000000000000000000000000000000000000000
STATUS=0
# One line per ref: <local ref> <local sha> <remote ref> <remote sha>.
while read -r LOCAL_REF LOCAL_SHA _ REMOTE_SHA; do
  if [ "$LOCAL_SHA" = "$ZERO" ]; then
    continue
  fi
  # stdin is this loop's, so the checker reads none of the refs still to come.
  PYTHONPATH="$ROOT" "$PY" -m tools.release.commits \
    --before "$REMOTE_SHA" --head "$LOCAL_SHA" < /dev/null
  CODE=$?
  if [ "$CODE" -eq 2 ]; then
    # 2 is a ref the remote has never seen and no main here to grade it
    # against: a clone lets such a push leave, a workflow gate may not.
    echo "pre-push: $LOCAL_REF has no base in this clone, so this push was not checked."
  elif [ "$CODE" -ne 0 ]; then
    STATUS=1
  fi
done
exit $STATUS
