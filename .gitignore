__pycache__/
*.pyc
.coverage
_demo_feed/
_bench_feed/

# The synthetic Knowledgebase reference feed the browser suite's demo build
# reads. Output of `make_synthetic_feed.py --knowledgebase`, never input.
_demo_kb/

# Licence PDFs. The text is the publisher's, and this repository is public.
# `licences/licence-manifest.json` is the tracked identity (filename, SHA-256,
# product id). A local copy is what `tools/check_release_clearance.py` hashes
# when it is here (ADR-0067).
licences/*.pdf

# Credentials. The marketplace issues a consumer key and secret per API product,
# and a secret in a tracked file is a secret that has to be rotated. Keep them in
# the environment, or in .env, which is ignored here on purpose.
.env
.env.*
*.secret

# Downloaded feeds and the non-secret download manifest. Licensed data: it is
# not ours to redistribute (ADR-0005; see the DTD research for the current
# publication gate), and the fares feed is large. `feeds/` is the folder the
# README's live commands use. Anchored to the root on purpose: an unanchored
# pattern would also ignore `trainbudget/feeds/`, which is the package's own
# feed downloaders, and a source file that is silently ignored is a file that is
# silently left out of a commit.
/feeds/
RJFAF*/
rjfaf*/
*.zip

demo.html
demo_*.html
_damaged*/
_damaged*.zip

# The per-station page set and the multi-origin build output (ADR-0019).
_site/
_cache/
_browser_demo.html
_browser_feed/

# The synthetic demo site the browser suite drives, and a base-path variant of
# a build. Both are output, never input: each is written afresh by
# `make_synthetic_feed.py` plus a `build_demo_page.py` run, so leaving one
# around only makes `git status` report it as untracked work.
_demo_site/
_site_base/

# The two page shapes the browser suite must meet every run: a
# prices-only page (no timetable) and a single-row page. Built by the
# deploy workflow's shape step and by anyone running the same commands
# locally, and output of the build like any other site folder.
_shape_feed/
_shape_site/

# A named subset build's output (build_stations.py). Its own folder rather than
# _site/, which the runner owns and tidies, so neither build deletes the other's
# station pages.
_stations/

# The station classification cache a build writes beside the feed it read.
location-types.json
*.location-types.json
_grantham_fresh.html
privacy/
.ons/

# Editor/agent local state and borrowed browser tooling.
.freebuff/
.impeccable/
node_modules/
_ef_cache/
